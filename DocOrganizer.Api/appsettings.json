{
  "ConnectionStrings": {
    "DocumentsDb": "Server=localhost;Database=DocOrganizerApiDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Oidc": {
    "Authority": "https://YOUR_TENANT.eu.auth0.com/",
    "Audience": "https://doc-organizer-api",
    "ClientId": "YOUR_SPA_CLIENT_ID",
    "RoleClaimType": "https://doc-organizer/roles",
    "NameClaimType": "https://doc-organizer/email",
    "Scopes": [
      "openid",
      "profile",
      "email"
    ]
  },
  "Seed": {
    "MemberAccountId": "auth0|REPLACE_WITH_MEMBER_USER_ID",
    "SecondMemberAccountId": "auth0|REPLACE_WITH_SECOND_MEMBER_USER_ID",
    "ViewerAccountId": "auth0|REPLACE_WITH_VIEWER_USER_ID",
    "LoadTestDocuments": 5000
  },
  "Performance": {
    "Optimized": true
  },
  "Cors": {
    "Origins": [
      "https://localhost:7042",
      "http://localhost:5042"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}